{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime-monitor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",

  // The React status page (built by Vite) is served as static assets.
  // Unknown paths fall back to index.html so client-side routes work.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Send /api/* straight to the Worker instead of looking for a static file first.
    "run_worker_first": ["/api/*"]
  },

  // Run the checks every 5 minutes. Change to "* * * * *" for every minute.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime",
      // Replace with the id printed by `pnpm wrangler d1 create uptime`
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // LiveStatus: holds the latest summary and the WebSocket of every open status page.
  // RegionChecker: one instance per region in REGIONS, placed with a location hint.
  // SQLite-backed Durable Objects are included in the Workers Free plan.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "LiveStatus" },
      { "name": "CHECKER", "class_name": "RegionChecker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveStatus"] },
    { "tag": "v2", "new_sqlite_classes": ["RegionChecker"] }
  ],

  "vars": {
    // Title shown on the status page
    "SITE_TITLE": "Status",
    // How many failed checks in a row before a monitor is marked down and an alert is sent
    "FAILURE_THRESHOLD": "2",
    // How long to keep individual check results
    "RETENTION_DAYS": "90",
    // Where checks run from (Durable Object location hints). A monitor counts as
    // failing only when most of these regions fail. Options: wnam, enam, sam,
    // weur, eeur, apac, oc, afr, me
    "REGIONS": "weur,enam,apac"
  },

  // Secrets (set with `pnpm wrangler secret put <NAME>`, never committed):
  //   ALERT_WEBHOOK_URL  Discord or Slack incoming webhook URL
  //   ADMIN_TOKEN        Bearer token for the admin API (adding/removing monitors)

  "observability": {
    "enabled": true
  }
}
