{
  "name": "uptime-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply uptime --local",
    "db:migrate:remote": "wrangler d1 migrations apply uptime --remote",
    "db:seed:local": "wrangler d1 execute uptime --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute uptime --remote --file=./seed.sql"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@12.14.0"
}
